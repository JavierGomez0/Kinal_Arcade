      <Button fx:id="btnWordle" layoutX="27.0" layoutY="116.0" mnemonicParsing="false" onAction="#clicWordle" styleClass="botones-arcade" stylesheets="@../resource/menuprincipalview.css" text="Wordle">
         <graphic>
            <ImageView fitHeight="65.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../image/Logo%20Wordle.png" />
               </image>
            </ImageView>
         </graphic></Button>
      <Button fx:id="btnTotito" layoutX="254.0" layoutY="224.0" mnemonicParsing="false" onAction="#clicWordle" styleClass="botones-arcade" text="Totito">
