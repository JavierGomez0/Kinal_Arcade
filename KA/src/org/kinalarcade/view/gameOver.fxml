<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="anchor-pane" stylesheets="@../resource/tetris.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="org.kinalarcade.controller.GameOverController">
   <children>
      <ImageView fitHeight="171.0" fitWidth="368.0" layoutX="116.0" layoutY="85.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../image/game.gif" />
         </image>
      </ImageView>
      <Button fx:id="btnMenu" layoutX="148.0" layoutY="260.0" mnemonicParsing="false" onAction="#regresarMenu" prefHeight="38.0" prefWidth="145.0" text="regresar">
         <styleClass>
            <String fx:value="action-button" />
            <String fx:value="botones-arcade" />
         </styleClass>
      </Button>
      <Button fx:id="btnReiniciar" layoutX="313.0" layoutY="260.0" mnemonicParsing="false" onAction="#regresarMenu" prefHeight="38.0" prefWidth="145.0" text="Reintentar">
         <styleClass>
            <String fx:value="action-button" />
            <String fx:value="botones-arcade" />
         </styleClass>
      </Button>
   </children>
</AnchorPane>
